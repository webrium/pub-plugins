{
    "name": "vue-admin-panel",
    "version": "1.0.0",
    "description": "Scaffolds a Vue.js-powered admin panel (controller, layout, Vite entry, root component). Drops VUE-ADMIN-PANEL-SETUP.md at the project root with the 3 remaining manual steps, shown automatically right after install.",
    "author": "Webrium",
    "require": {
        "webrium/core": ">=5.2.0"
    },
    "export": [
        {
            "file": "app/Controllers/AdminController.php",
            "dest": "controllers",
            "subpath": null,
            "overwrite": false
        },
        {
            "file": "app/Views/layouts/Admin.php",
            "dest": "views",
            "subpath": "layouts",
            "overwrite": false
        },
        {
            "file": "resources/js/admin.js",
            "dest": "resources",
            "subpath": "js",
            "overwrite": false
        },
        {
            "file": "resources/js/admin/Admin.vue",
            "dest": "resources",
            "subpath": "js/admin",
            "overwrite": false
        },
        {
            "file": "VUE-ADMIN-PANEL-SETUP.md",
            "dest": "root",
            "subpath": null,
            "overwrite": true
        }
    ],
    "sql": [],
    "hooks": {
        "before_install": [],
        "after_install": []
    },
    "meta": {
        "guide_slug": "using-vuejs-with-webrium"
    },
    "post_install_message": null,
    "post_install_message_file": "VUE-ADMIN-PANEL-SETUP.md"
}